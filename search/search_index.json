43d\u043d\u044b\u0445 (\u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0451\u043d\u043d\u044b\u0445) \u0442\u0443\u0440\u043e\u0432: \u0441\u0442\u0440\u0430\u043d\u0430, \u0442\u0443\u0440, \u043a\u043b\u0438\u0435\u043d\u0442, \u0434\u0430\u0442\u044b. Django-admin ( /django-admin/ \u0438\u043b\u0438 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u0439 /admin/ backend) \u0410\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440 \u043c\u043e\u0436\u0435\u0442 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044c \u0440\u0435\u0437\u0435\u0440\u0432\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0433\u0430\u043b\u043e\u0447\u043a\u043e\u0439 is_confirmed \u0432 \u0441\u043f\u0438\u0441\u043a\u0435 \u0431\u0440\u043e\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0439 ( list_editable ). \u0420\u0430\u0437\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0435 \u043f\u0440\u0430\u0432 \u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0413\u043e\u0441\u0442\u044c \u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c Staff \u041f\u0440\u043e\u0441\u043c\u043e\u0442\u0440 \u0442\u0443\u0440\u043e\u0432 \u0438 \u043e\u0442\u0437\u044b\u0432\u043e\u0432 \u2713 \u2713 \u2713 \u0411\u0440\u043e\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 / \u0441\u0432\u043e\u0438 \u0437\u0430\u044f\u0432\u043a\u0438 \u2713 \u2713 \u041e\u0442\u0437\u044b\u0432\u044b \u2713 \u2713 \u041f\u0430\u043d\u0435\u043b\u044c /admin \u0438 \u0442\u0430\u0431\u043b\u0438\u0446\u0430 \u043f\u0440\u043e\u0434\u0430\u0436 \u2713 \u041f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435 \u0432 Django-admin \u2713 \u041d\u0430 \u043a\u043b\u0438\u0435\u043d\u0442\u0435 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 user.is_staff \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442 \u043f\u0443\u043d\u043a\u0442\u043e\u043c \u043c\u0435\u043d\u044e \u0438 \u0434\u043e\u0441\u0442\u0443\u043